<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item> -->

        <item name="colorPrimary">@color/white</item>   <!-- dark_blue previously -->
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorSecondaryVariant">@color/yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowLightStatusBar">false</item> <!-- White icons/text -->
    </style>
    <style name="AppThemeActivity" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorSecondaryVariant">@color/yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/slapimage_top_bar_black</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="CalculatorButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/dark_gray</item>
        <item name="cornerRadius">36dp</item>
    </style>

    <!-- Custom style for BottomNavigationView -->
    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextAppearance</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Custom TextAppearance for BottomNavigationView -->
    <style name="BottomNavigationTextAppearance">
        <item name="android:textSize">10sp</item> <!-- Change the font size here -->
        <item name="android:fontFamily">sans-serif-medium</item> <!-- Optional: Change font family -->
        <!-- Define colors for bottom navigation  -->
    </style>
    <style name="Theme.MyApp.Mp3Player" parent="Theme.MaterialComponents.DayNight">
        <!-- Your theme attributes -->
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/yellow</item>
        <item name="colorSecondaryVariant">@color/yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
    <style name="AppTheme.GameofLife" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Base application theme DayNight.DarkActionBar -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
    <style name="GeminiTransition" parent="android:Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/no_animation</item>
    </style>
    <style name="CodeBlockStyle">
        <item name="android:background">@color/code_block_background</item>
        <item name="android:textColor">@color/code_block_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Add to colors.xml -->
    <color name="code_block_background">#F5F5F5</color>
    <color name="code_block_text">#333333</color>

    <attr name="themeColor" format="color"/>

    <!--    Background as well as text color for alert dialog buttons-->
    <attr name="dialogTextColor" format="color"/>
    <attr name="dialogBtnBackground" format="color"/>

    //Theme for Activities
    <style name="coolPink" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="themeColor">@color/cool_pink</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="dialogBtnBackground">@color/dark_blue</item>
        <item name="dialogTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
    <style name="coolBlue" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="themeColor">@color/cool_blue</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="dialogBtnBackground">@color/dark_blue</item>
        <item name="dialogTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>



    //Theme for Navigation Drawer
    <style name="coolPinkNav" parent="Theme.MaterialComponents.Light">
        <item name="themeColor">@color/cool_pink</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/cool_pink</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="dialogBtnBackground">@color/dark_blue</item>
        <item name="dialogTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
    <style name="coolBlueNav" parent="Theme.MaterialComponents.Light">
        <item name="themeColor">@color/cool_blue</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/cool_pink</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="dialogBtnBackground">@color/dark_blue</item>
        <item name="dialogTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>


    //new dark Theme
    <style name="coolBlack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="themeColor">@color/black</item>
        <item name="colorPrimary">@color/black</item> //purple_500
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item> // white
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item> //teal_700
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/themeColor</item>
        <item name="dialogBtnBackground">@color/white</item>
        <item name="dialogTextColor">@color/black</item>
    </style>
    <style name="coolBlackNav" parent="Theme.MaterialComponents.DayNight">
        <item name="themeColor">@color/black</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cool_pink</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/themeColor</item>
        <item name="dialogBtnBackground">@color/white</item>
        <item name="dialogTextColor">@color/black</item>
    </style>

    // Tetris
    <style name="Theme.Composetetris" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Composetetris.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Composetetris.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Composetetris.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

    </style>


    <style name="CalculatorTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="CustomDisplayAngleAppearance">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">10dp</item>

    </style>
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_right</item>
        <item name="android:windowExitAnimation">@anim/slide_left</item>
    </style>

    <style name="textStyle">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">30sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="operatorButton" parent="textStyle">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="numericButton" parent="textStyle">
        <item name="android:textColor">@color/colorCardDT</item>
    </style>

    <style name="Theme.Metadator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
    </style>
    <style name="TextPadAppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/TextPadColorPrimary</item>
        <item name="android:colorBackground">@color/TextPadTextColorPrimary</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>
    <style name="Theme.MBCompass" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <style name="StyledIndicatorsWhite" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="StyledIndicatorsBlack" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>


    <style name="PagerTabStripText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#a4c639</item>
    </style>


    <style name="navBG">
        <item name="android:background">#60000000</item>
    </style>

    <style name="listBG">
        <item name="android:background">#90000000</item>
    </style>

    <style name="navBGButton">
        <item name="android:tint">@color/tint_white</item>
        <item name="android:background">@drawable/wp_button</item>
    </style>

    <style name="wpButton">
        <item name="android:tint">@color/tint_white</item>
        <item name="android:padding">5dip</item>
        <item name="android:layout_margin">2dip</item>
        <item name="android:background">@drawable/wp_button</item>
    </style>

    <style name="wpButtonM0">
        <item name="android:padding">5dip</item>
        <item name="android:background">@drawable/wp_button</item>
    </style>


    <style name="buttonWhiteInverted">
        <item name="android:background">@drawable/bg_border_white</item>
        <item name="android:padding">4dip</item>
        <item name="android:layout_marginLeft">1.5dip</item>
        <item name="android:layout_marginRight">1.5dip</item>
        <item name="android:tint">?android:attr/textColorLink</item>
    </style>


    <style name="buttonWhite">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">3dip</item>
        <item name="android:layout_marginLeft">1.5dip</item>
        <item name="android:layout_marginRight">1.5dip</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="buttonWhiteClose" parent="buttonWhite">
        <item name="android:padding">4dip</item>
    </style>

    <style name="textLink">
        <item name="android:padding">5dip</item>
        <item name="android:minEms">4</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:tag">textLink</item>
        <item name="android:textColor">?android:attr/textColorLink</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="textLinkWhite" parent="textLink">
        <item name="android:tag">textLinkWhite</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="textLinkStyle">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?android:attr/textColorLink</item>
    </style>

    <style name="buttonClear">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:padding">4dip</item>
        <item name="android:tint">@color/tint_gray</item>
    </style>

    <style name="textSection">
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dip</item>
        <item name="android:background">#60e1e1e1</item>
    </style>


    <style name="textCircle">
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/bg_circular</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:text">A</item>
        <item name="android:layout_marginRight">8dip</item>
        <item name="android:layout_marginLeft">4dip</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MyToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <!-- Back/Up arrow color -->
        <item name="colorControlNormal">@android:color/white</item>
        <!-- Search/menu icon color -->
        <item name="actionMenuTextColor">@android:color/white</item> <!-- Menu icons -->
        <item name="android:textColorSecondary">@android:color/white</item> <!-- SearchView text -->

    </style>
</resources>