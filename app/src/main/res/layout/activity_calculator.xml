<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context=".gridiconactivity.CalculatorActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:title="Calculator"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white"> <!-- Force white tint -->

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/calculator"
            android:tint="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            tools:ignore="ContentDescription"/>

    </com.google.android.material.appbar.MaterialToolbar>
<!--
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="end"
        android:text="@string/zero"
        android:textColor="@color/white"
        android:textSize="48sp" /> -->
    <!-- Previous calculation display -->
    <TextView
        android:id="@+id/previous_calculation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="end"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        tools:text="123 + 456" />

    <!-- Current input display -->
    <TextView
        android:id="@+id/current_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="end"
        android:text="@string/zero"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        tools:text="579" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_clear"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/light_gray"
            android:text="@string/AC"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btn_delete"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/light_gray"
            android:text="@string/DEL"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/orange"
            android:text="@string/divide"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_7"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/seven" />

        <Button
            android:id="@+id/btn_8"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/eight" />

        <Button
            android:id="@+id/btn_9"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/nine" />

        <Button
            android:id="@+id/btn_multiply"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/orange"
            android:text="@string/times"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@color/black"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_4"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/four" />

        <Button
            android:id="@+id/btn_5"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/five" />

        <Button
            android:id="@+id/btn_6"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/six" />

        <Button
            android:id="@+id/btn_subtract"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/orange"
            android:text="@string/minus"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_1"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/one" />

        <Button
            android:id="@+id/btn_2"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/two" />

        <Button
            android:id="@+id/btn_3"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/three" />

        <Button
            android:id="@+id/btn_add"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/orange"
            android:text="@string/plus"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_0"
            style="@style/CalculatorButton"
            android:layout_weight="2"
            android:text="@string/zero" />

        <Button
            android:id="@+id/btn_decimal"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:text="@string/dot" />

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalculatorButton"
            android:layout_weight="1"
            android:backgroundTint="@color/orange"
            android:text="@string/equal"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
