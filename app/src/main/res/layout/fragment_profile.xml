<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:background="@color/light_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Add your UI elements here -->
    <!-- Photo Bar Container with Black Background -->
    <RelativeLayout
        android:id="@+id/photoBarContainer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/slapimage_top_bar_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- ImageView that scales to fit height and aligns to the left -->
        <ImageView
            android:id="@+id/photoBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:layout_alignParentStart="true"
            android:contentDescription="@string/top_bar"
            android:src="@drawable/slapimage_bw_logo" />
</RelativeLayout>
    <!-- ImageView to display an image above the TextView -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/profile_logo_width"
        android:layout_height="@dimen/profile_logo_height"
        android:src="@drawable/slap_imagelogo"
        android:background="@drawable/border"
        android:scaleType="fitCenter"
        android:contentDescription="@string/logo_description"
        android:layout_marginTop="@dimen/profile_logo_margintop"
        app:layout_constraintTop_toBottomOf="@id/photoBarContainer"
        app:layout_constraintBottom_toTopOf="@+id/tvbMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView to display a message -->
    <TextView
        android:id="@+id/tvbMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slapImage"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:maxWidth="320dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintBottom_toTopOf="@+id/tvMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:maxWidth="320dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvbMessage"
        app:layout_constraintBottom_toTopOf="@+id/ivBernard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivBernard"
        android:layout_width="98dp"
        android:layout_height="96dp"
        android:src="@drawable/bernard_icon"
        android:background="@drawable/border"
        android:scaleType="fitCenter"
        android:contentDescription="@string/logo_description"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvMessage"
        app:layout_constraintBottom_toTopOf="@+id/ivGPL3Logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/ivGPL3Logo"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_gplv3"
        android:scaleType="fitCenter"
        android:contentDescription="@string/logo_description"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintTop_toBottomOf="@id/ivBernard"
        app:layout_constraintBottom_toTopOf="@+id/btnQuitProgram"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- Button to quit the program -->
    <Button
        android:id="@+id/btnQuitProgram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quit_program"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:backgroundTint="@color/purple_500"
        android:layout_marginTop="120dp"
        android:layout_marginBottom="0dp"
        android:maxWidth="320dp"
        app:layout_constraintTop_toBottomOf="@id/ivBernard"
        app:layout_constraintBottom_toTopOf="@+id/line1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/line1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/splash_line1"
        android:textColor="@color/black"
        android:textSize="11sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btnQuitProgram"
        app:layout_constraintBottom_toTopOf="@+id/line2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/line2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/splash_line2"
        android:textColor="@color/black"
        android:textSize="11sp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/line1"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

