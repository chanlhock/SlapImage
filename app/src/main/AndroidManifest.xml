<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.slapimage">

    <!-- For Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- For Android 13 and above -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Notification-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Notification Permission for Android 14 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- New Calculator -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:name=".musicplayer.ApplicationClass"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="false">

    <!-- MainActivity with android:exported explicitly set -->
        <activity
            android:name=".SplashActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:exported="false"
            android:launchMode="singleTop"/>
        <activity android:name=".gridiconactivity.ComingSoonActivity"
            android:theme="@style/AppThemeActivity"/>
        <activity android:name=".PlaceholderActivity" />
        <activity android:name=".gridiconactivity.CalendarActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeActivity"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:exported="false"/>
        <activity android:name=".gridiconactivity.StockActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/AppThemeActivity"/>
        <activity android:name=".gridiconactivity.CalculatorActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeActivity"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:exported="false"/>
        <activity android:name=".gridiconactivity.GalleryActivity"
            android:theme="@style/AppThemeActivity"/>
        <activity android:name=".gridiconactivity.FolderContentsActivity" />
        <activity android:name=".gridiconactivity.PhotoViewerActivity" />
        <activity
            android:name=".GeminiAIChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".gridiconactivity.MusicPlayerActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeActivity"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:label="Music Player"
            android:exported="false" />

        <activity
            android:name=".gridiconactivity.TextViewerActivity"
            android:theme="@style/AppThemeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <activity
            android:name=".gridiconactivity.GameOfLifeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/AppTheme.GameofLife" />
        <activity
            android:name=".gridiconactivity.SimulationActivity"
            android:theme="@style/AppTheme.GameofLife"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:parentActivityName=".gridiconactivity.GameOfLifeActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".gridiconactivity.GameOfLifeActivity" />
        </activity>

        <activity
            android:name=".musicplayer.PlayNext"
            android:exported="false" />

        <activity
            android:name=".musicplayer.SettingsActivity"
            android:screenOrientation="sensorPortrait"
            android:configChanges="uiMode|orientation"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".musicplayer.SelectionActivity"
            android:screenOrientation="sensorPortrait"
            android:configChanges="uiMode|orientation"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".musicplayer.PlaylistDetails"
            android:screenOrientation="sensorPortrait"
            android:configChanges="uiMode|orientation"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".musicplayer.PlaylistActivity"
            android:screenOrientation="sensorPortrait"
            android:configChanges="uiMode|orientation"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".musicplayer.FavouriteActivity"
            android:screenOrientation="sensorPortrait"
            android:configChanges="uiMode|orientation"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".musicplayer.PlayerActivity"
            android:configChanges="uiMode|orientation"
            android:exported="true"
            android:launchMode="standard"
            android:noHistory="true"
            android:screenOrientation="sensorPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:mimeType="audio/*"
                    android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".musicplayer.MainMusicActivity"
            android:configChanges="uiMode|orientation"
            android:exported="true"
            android:screenOrientation="sensorPortrait"
            android:launchMode="standard"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
        </activity>
        <activity
            android:name=".tetris.TetrisActivity"
            android:exported="true"
            android:label="@string/tetris"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/Theme.Composetetris.NoActionBar">
        </activity>
        <!-- Updated Permission for Android 14   -->
        <service
            android:name=".musicplayer.MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
            />

        <receiver
            android:name=".musicplayer.NotificationReceiver"
            android:enabled="true" />

        <activity
            android:name=".newcalculator.CalcMainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>
        <activity android:name=".newcalculator.screens.DataScreen" />

        <activity
            android:name=".tictactoe.content.TicTacToeMainActivity"
            android:configChanges="locale|fontScale|orientation|screenSize|keyboardHidden|keyboard|locale|screenLayout|screenSize|layoutDirection"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme">
        </activity>
    </application>

</manifest>